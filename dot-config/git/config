[alias]
	br = branch
cam = "commit -am"
cm = "commit -m"
	co = checkout
	st = status
	ci = commit

[core]
pager = "delta"

[delta]
line-numbers = true
side-by-side = true
theme = "Catppuccin Mocha"

[gpg]
format = "openpgp"

[gpg "openpgp"]
program = "/usr/bin/gpg"

[init]
	defaultBranch = main

[interactive]
diffFilter = "delta --color-only"

[push]
autoSetupRemote = true

[user]
email = "olirafa@proton.me"
name = "Rafael Augusto de Oliveira"

[credential "https://github.com"]
	helper = 
	helper = !/home/linuxbrew/.linuxbrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/home/linuxbrew/.linuxbrew/bin/gh auth git-credential
[pull]
	rebase = true
